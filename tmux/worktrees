#!/usr/bin/env bash
# worktrees [repo] — pick a git worktree, browse what it changed, or open lazygit in it.
# Each row: ticket, tracker status, dev server port, uncommitted files, commits ahead of master, title.
# Worktree list:
#   enter   changed files (vs master + uncommitted + untracked), diff per file in the preview
#   ctrl-l  lazygit in that worktree (q returns here)
#   ctrl-w  new tmux window in it, named after the ticket
#   ctrl-y  copy its path
#   esc     close
# Files list:
#   j/k     move                            h/l (or arrows)  fold / unfold a folder (h on a file folds its folder)
#   W / E   fold / unfold all                /  search (esc closes it, enter keeps the filter)
#   enter   the file's changes one by one, or fold/unfold a folder   e  edit the file   ctrl-l  lazygit
#   pgup/pgdn line by line, ctrl-d/u half a page   ctrl-o  diff full screen in less (select and copy there)
#   ctrl-s  toggle side-by-side diff
#   esc     back to the worktrees
# Changes list (one file, one row per hunk):
#   j/k     next / previous change          c  comment on it (saved for the task's agent to pick up)
#   e/enter edit the file at that line      esc  back to the files
# repo: any path inside a repo to list only that one (default: every repo in ~/Documents/GitHub with
# worktrees, plus the current one).
set -u
self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
tasks=~/Documents/GitHub/msw-kit/data/tasks.json

base_of() {
  git -C "$1" rev-parse --verify -q origin/master >/dev/null && echo origin/master || echo origin/main
}

# Repos to list: the one given, else every repo in ~/Documents/GitHub with linked worktrees (ones whose folder is gone do not count) plus the
# repo of the current directory.
repos() {
  if [ -n "${1:-}" ]; then git -C "$1" rev-parse --show-toplevel; return; fi
  {
    git -C "$PWD" rev-parse --show-toplevel 2>/dev/null
    for d in ~/Documents/GitHub/*/; do
      [ -e "$d.git" ] && [ "$(git -C "$d" worktree list 2>/dev/null | grep -vc " prunable$")" -gt 1 ] && echo "${d%/}"
    done
  } | awk '!seen[$0]++'
}

list() {
  local repo base ports
  ports=$(curl -s --max-time 0.5 localhost:3333/__branch/list 2>/dev/null | jq -r '.branches[]? | "\(.root)\t\(.port)"' 2>/dev/null)
  repos "${1:-}" | while read -r repo; do
  base=$(base_of "$repo")
  git -C "$repo" worktree list --porcelain | while read -r k v; do
    case $k in
      worktree) path=$v; branch='(detached)';;
      branch) branch=${v#refs/heads/};;
      '')
        [ -d "$path" ] || continue
        key=$(printf %s "$branch" | grep -oiE '^[a-z][a-z0-9]+-[0-9]+' | tr a-z A-Z || true)
        title='' status=''
        if [ -n "$key" ] && [ -f "$tasks" ]; then
          IFS=$'\t' read -r status title < <(jq -r --arg k "$key" '.[$k] // {} | [(.status // ""), (.title // "")] | @tsv' "$tasks")
        fi
        dirty=$(git -C "$path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        ahead=$(git -C "$path" rev-list --count "$base..HEAD" 2>/dev/null || echo 0)
        port=$(printf '%s\n' "$ports" | awk -F'\t' -v p="$path" '$1 == p {print ":" $2}')
        # ticket lowercased: hpnl-13242/localized-promo-prices
        name=$branch
        [ -n "$key" ] && name=$(printf %s "${branch:0:${#key}}" | tr A-Z a-z)${branch:${#key}}
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$path" "$(basename "$repo")" "$name" "${status//_/ }" "$port" \
          "$([ "$dirty" -gt 0 ] && echo "✎$dirty")" "$([ "$ahead" -gt 0 ] && echo "↑$ahead")" "$title"
        ;;
    esac
  done
  done | columns
}

# Raw "path \t repo \t branch \t status \t port \t changed \t ahead \t title" rows -> a header row and aligned,
# coloured columns. Padding counts characters, not bytes, so ✎ and ↑ do not push columns out.
columns() {
  perl -CS -e '
    my @rows = ([("") , "REPO", "BRANCH", "STATUS", "PORT", "CHANGED", "AHEAD", "TITLE"]);
    while (<STDIN>) { chomp; push @rows, [split /\t/, $_, 8] }
    my @w; for my $r (@rows) { for my $i (1 .. 6) { my $l = length($r->[$i] // ""); $w[$i] = $l if $l > ($w[$i] // 0) } }
    my @c = (undef, "34", "1", "35", "32", "33", "36", "2");
    for my $n (0 .. $#rows) {
      my $r = $rows[$n];
      my $line = join "  ", map { my $v = $r->[$_] // ""; my $p = $_ < 7 ? $v . " " x ($w[$_] - length $v) : $v; $n ? "\e[$c[$_]m$p\e[0m" : "\e[2;4m$p\e[0m" } 1 .. 7;
      print "$r->[0]\t$line\n";
    }
  '
}

# Everything the branch changed: committed since the merge base with master, plus uncommitted and untracked.
files() {
  local wt=$1 mb
  mb=$(git -C "$wt" merge-base HEAD "$(base_of "$wt")" 2>/dev/null || echo HEAD)
  {
    git -C "$wt" diff --name-status "$mb" | awk -F'\t' '{print $1 "\t" $NF}'
    git -C "$wt" ls-files --others --exclude-standard | awk '{print "?\t" $0}'
  } | while IFS=$'\t' read -r st f; do
    printf '%s\t%s\t%s\n' "${st:0:1}" "$f" "$(git -C "$wt" diff --numstat "$mb" -- "$f" 2>/dev/null | awk '{print "+" $1 " -" $2}')"
  done > "$(state "$wt").rows"
  tree "$wt"
}

# Per-worktree scratch: <state>.rows caches the git rows, <state>.collapsed lists folded directories.
state() {
  printf %s "${TMPDIR:-/tmp}/worktrees-$(printf %s "$1" | md5 -q)"
}

# "status \t path \t stat" rows -> a lazygit-style tree. Directories with a single subdirectory are
# folded into one row (src/components/DomainChecker). Every row's first field is its path, so a
# directory row previews the diff of everything under it.
# Collapsed directories show ▸ and hide their contents. `tree <wt> dirs` prints every directory row's
# path instead, collapsed or not (for collapse all).
tree() {
  local s
  s=$(state "$1")
  touch "$s.collapsed"
  perl -e '
    my ($collapsed, $mode) = @ARGV;
    open my $fh, "<", $collapsed; my %folded = map { chomp; ($_ => 1) } <$fh>;
    my %color = (A => 32, "?" => 32, D => 31, R => 36);
    my $root = { d => {}, f => [] };
    while (<STDIN>) {
      chomp; my ($st, $path, $stat) = split /\t/, $_, 3;
      my @parts = split m{/}, $path; my $name = pop @parts; my $n = $root;
      $n = $n->{d}{$_} //= { d => {}, f => [] } for @parts;
      push @{ $n->{f} }, [$st, $name, $path, $stat // ""];
    }
    sub walk {
      my ($n, $prefix, $dir) = @_;
      my @kids = ((map { [d => $_] } sort keys %{ $n->{d} }), (map { [f => $_] } sort { $a->[1] cmp $b->[1] } @{ $n->{f} }));
      for my $i (0 .. $#kids) {
        my $last = $i == $#kids; my ($kind, $k) = @{ $kids[$i] };
        my $branch = $prefix . ($last ? "└─ " : "├─ "); my $next = $prefix . ($last ? "   " : "│  ");
        if ($kind eq "d") {
          my ($name, $c) = ($k, $n->{d}{$k});
          while (!@{ $c->{f} } && keys %{ $c->{d} } == 1) { my ($only) = keys %{ $c->{d} }; $name .= "/$only"; $c = $c->{d}{$only} }
          my $path = "$dir$name/";
          if ($mode eq "dirs") { print "$path\n"; walk($c, $next, $path); next }
          my $closed = $folded{$path} && $mode ne "all";
          printf "%s\t\e[2m%s\e[0m\e[34m%s %s\e[0m\n", $path, $branch, $closed ? "▸" : "▾", $name;
          walk($c, $next, $path) unless $closed;
        } else {
          next if $mode eq "dirs";
          my ($st, $name, $path, $stat) = @$k;
          printf "%s\t\e[2m%s\e[0m\e[%sm%s\e[0m %s \e[2m%s\e[0m\n", $path, $branch, $color{$st} // 33, $st, $name, $stat;
        }
      }
    }
    walk($root, "", "");
  ' "$s.collapsed" "${2:-}" < "$s.rows"
}

# Keys in the files list. The search input is hidden until `/`; while it is open, letters type.
# Prints fzf actions for `transform`.
act() {
  local key=$1 wt=$2 row=$3 s target parent
  s=$(state "$wt")
  if [ "${FZF_INPUT_STATE:-hidden}" != hidden ]; then
    case $key in
      esc) echo 'clear-query+hide-input';;
      enter) echo 'hide-input';;
      left) echo backward-char;;
      right) echo forward-char;;
      *) echo "put($key)";;
    esac
    return
  fi
  # the directory row that holds this row: the longest directory row path that is a prefix of it
  parent=$(tree "$wt" dirs | awk -v r="$row" 'index(r, $0) == 1 && r != $0 && length($0) > length(p) { p = $0 } END { print p }')
  case $key in left) key=h;; right) key=l;; esac
  target=$row
  case $key in
    j) echo down; return;;
    k) echo up; return;;
    /) echo show-input; return;;
    e) [[ $row == */ ]] || echo "execute(cd '$wt' && \${EDITOR:-nvim} '$row')"; return;;
    esc) echo abort; return;;
    enter)
      case $row in
        */) toggle "$s" "$row";;
        *) echo "execute($self --changes '$wt' '$row')+reload-sync($self --tree '$wt')"; return;;
      esac;;
    h)
      if [[ $row == */ ]] && ! grep -qxF "$row" "$s.collapsed"; then
        echo "$row" >> "$s.collapsed"
      elif [ -n "$parent" ]; then
        echo "$parent" >> "$s.collapsed"; target=$parent
      else
        return
      fi;;
    l)
      if [[ $row == */ ]] && grep -qxF "$row" "$s.collapsed"; then toggle "$s" "$row"; else echo down; return; fi;;
    W) tree "$wt" dirs > "$s.collapsed"; target=$(tree "$wt" | cut -f1 | awk -v r="$row" 'index(r, $0) == 1 { print; exit }');;
    E) : > "$s.collapsed";;
  esac
  local n
  n=$(tree "$wt" | cut -f1 | grep -nxF "${target:-$row}" | cut -d: -f1 | head -1)
  echo "reload-sync($self --tree '$wt')${n:++pos($n)}"
}

toggle() {
  if grep -qxF "$2" "$1.collapsed"; then
    grep -vxF "$2" "$1.collapsed" > "$1.tmp"; mv -f "$1.tmp" "$1.collapsed"
  else
    echo "$2" >> "$1.collapsed"
  fi
}

# The file's diff against the merge base with master (untracked files: all of it as added).
raw_diff() {
  local wt=$1 f=$2 mb
  mb=$(git -C "$wt" merge-base HEAD "$(base_of "$wt")" 2>/dev/null || echo HEAD)
  cd "$wt" || exit
  if git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 || git cat-file -e "$mb:$f" 2>/dev/null; then
    git diff "$mb" -- "$f"
  else
    git diff --no-index -- /dev/null "$f"
  fi
}

render() {
  delta --paging=never --width="$(( ${FZF_PREVIEW_COLUMNS:-$(tput cols)} - 2 ))" --hunk-header-decoration-style="blue ul" --hunk-header-style="line-number syntax" ${1:+--side-by-side}
}

diff_one() {
  raw_diff "$1" "$2" | render "${3:-}"
}

# ---- review comments: c on a change saves it for the task, so an agent picks it up in review ----
# One JSONL file per task in msw-kit/data/comments/<KEY>.jsonl; the msw-kit tasks_comments tool reads
# and resolves them, tasks w shows the open count.
comments_dir=~/Documents/GitHub/msw-kit/data/comments

# Task key for a worktree: the ticket in its branch name, else the tracker task that lists this
# branch, else the branch name itself (adhoc/foo -> adhoc-foo).
task_key() {
  local branch key
  branch=$(git -C "$1" branch --show-current)
  key=$(printf %s "$branch" | grep -oiE '^[a-z][a-z0-9]+-[0-9]+' | tr a-z A-Z)
  [ -n "$key" ] || key=$(jq -r --arg b "$branch" 'to_entries[] | select(.value.branch == $b or ((.value.prs // []) | any(.branch == $b))) | .key' "$tasks" 2>/dev/null | head -1)
  [ -n "$key" ] || key=$(printf %s "$branch" | tr '/' '-' | tr A-Z a-z)
  printf %s "$key"
}

# Hunks of one file: "index \t new-file line \t display" rows; the display carries the comment count.
hunks() {
  local wt=$1 f=$2 key
  key=$(task_key "$wt")
  raw_diff "$wt" "$f" | perl -CS -Mutf8 -e '
    my ($file, $cfile) = @ARGV; my %count;
    if (open my $c, "<:utf8", $cfile) { while (<$c>) { $count{"$1"}++ if /"file":"\Q$file\E".*"line":(\d+).*"status":"open"/ } }
    # line = first changed line in the new file (where a deletion-only change sits)
    my ($i, $cur, $line, $ctx, $first, $add, $del) = (0);
    my $flush = sub {
      return unless $i;
      my $n = $count{$line} ? sprintf("  \e[33m💬%d\e[0m", $count{$line}) : "";
      printf "%d\t%d\t\e[2mL%-5d\e[0m \e[32m+%d\e[0m \e[31m-%d\e[0m  %s\e[2m%s\e[0m%s\n", $i, $line, $line, $add, $del, $first // "", $ctx ? "  · $ctx" : "", $n;
    };
    while (<STDIN>) {
      chomp;
      if (/^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@ ?(.*)/) { $flush->(); $i++; ($cur, $line, $ctx, $first, $add, $del) = ($1, undef, substr($2, 0, 40), undef, 0, 0); next }
      next unless $i;
      if (/^([+-])(.*)/) {
        $line //= $cur; $1 eq "+" ? $add++ : $del++;
        ($first //= $2) =~ s/^\s+//; $first = substr($first, 0, 70);
        $cur++ if $1 eq "+";
      } elsif (/^ /) { $cur++ }
    }
    $flush->();
  ' "$f" "$comments_dir/$key.jsonl"
}

# Diff header plus hunk <n> only, so the preview shows just that change; open comments on it below.
hunk_diff() {
  local wt=$1 f=$2 n=$3 key
  key=$(task_key "$wt")
  raw_diff "$wt" "$f" | perl -e '
    my $n = shift; my ($i, @head) = (0);
    while (<STDIN>) { if (/^@@/) { $i++ } if (!$i) { push @head, $_ } elsif ($i == $n) { print @head if @head; @head = (); print } }
  ' "$n" | render
  local line
  line=$(hunks "$wt" "$f" | awk -F'\t' -v n="$n" '$1 == n { print $2 }')
  [ -f "$comments_dir/$key.jsonl" ] && jq -r --arg f "$f" --argjson l "${line:-0}" \
    'select(.file == $f and .line == $l and .status == "open") | "\u001b[33m💬 " + .text + "\u001b[0m"' "$comments_dir/$key.jsonl"
}

add_comment() {
  local wt=$1 f=$2 n=$3 text=$4 key line snippet
  [ -n "${text// }" ] || return
  key=$(task_key "$wt")
  line=$(hunks "$wt" "$f" | awk -F'\t' -v n="$n" '$1 == n { print $2 }')
  snippet=$(raw_diff "$wt" "$f" | perl -e 'my $n = shift; my $i = 0; while (<STDIN>) { $i++ if /^@@/; print if $i == $n }' "$n" | head -60)
  mkdir -p "$comments_dir"
  jq -cn --arg id "$(openssl rand -hex 4)" --arg ts "$(date -u +%FT%TZ)" --arg key "$key" \
    --arg branch "$(git -C "$wt" branch --show-current)" --arg worktree "$wt" --arg file "$f" \
    --argjson line "${line:-0}" --arg hunk "$snippet" --arg text "$text" \
    '{id: $id, ts: $ts, key: $key, branch: $branch, worktree: $worktree, file: $file, line: $line, hunk: $hunk, text: $text, status: "open"}' \
    >> "$comments_dir/$key.jsonl"
}

# Keys in the changes list (one file). c opens the comment input; enter saves it, esc drops it.
act_hunk() {
  local key=$1 wt=$2 f=$3 n=$4 line
  local header="$f · j/k next/previous change · c comment · e edit here · ctrl-s side by side · esc back"
  # commenting: the diff moves below so the input gets the full width; back restores the layout
  local back="clear-query+hide-input+change-prompt($(basename "$f")> )+change-header($header)+change-preview-window(right,70%,border-left)"
  if [ "${FZF_INPUT_STATE:-hidden}" != hidden ]; then
    case $key in
      enter) add_comment "$wt" "$f" "$n" "${FZF_QUERY:-}"
             echo "$back+reload-sync($self --hunks '$wt' '$f')+pos($n)+refresh-preview";;
      esc) echo "$back";;
      *) echo "put($key)";;
    esac
    return
  fi
  case $key in
    j) echo down;;
    k) echo up;;
    c) line=$(hunks "$wt" "$f" | awk -F'\t' -v n="$n" '$1 == n { print $2 }')
       echo "show-input+change-prompt(💬 )+change-header(comment on $(basename "$f"):$line · enter saves · esc cancels)+change-preview-window(down,60%,border-top)";;
    e|enter) line=$(hunks "$wt" "$f" | awk -F'\t' -v n="$n" '$1 == n { print $2 }')
             echo "execute(cd '$wt' && \${EDITOR:-nvim} +${line:-1} '$f')";;
    esc) echo abort;;
  esac
}

changes() {
  local wt=$1 f=$2 k binds=()
  for k in j k c e enter esc; do binds+=(--bind="$k:transform:$self --act-hunk $k '$wt' '$f' {1}"); done
  hunks "$wt" "$f" | fzf --ansi --delimiter='\t' --with-nth=3 --no-sort --layout=reverse --cycle --no-input --disabled \
    --prompt="$(basename "$f")> " \
    --header="$f · j/k next/previous change · c comment · e edit here · ctrl-s side by side · esc back" \
    "${binds[@]}" \
    --preview="$self --hunk '$wt' '$f' {1}" \
    --preview-window='right,70%,border-left' \
    --bind='ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up,page-down:preview-down,page-up:preview-up' \
    --bind="ctrl-s:change-preview($self --diff '$wt' '$f' sbs)+change-preview-window(down,75%,border-top)"
}

browse() {
  local wt=$1
  local k binds=()
  for k in j k h l W E e / enter esc; do binds+=(--bind="$k:transform:$self --act $k '$wt' {1}"); done
  files "$wt" | fzf --ansi --delimiter='\t' --with-nth=2 --no-sort --layout=reverse --cycle --no-input \
    --prompt="$(basename "$wt")> " \
    --header='j/k move · h/l fold · W/E fold/unfold all · / search · enter changes + comments · e edit · ctrl-o full screen · ctrl-s side by side · ctrl-l lazygit · esc back' \
    "${binds[@]}" \
    --bind="left:transform:$self --act left '$wt' {1},right:transform:$self --act right '$wt' {1}" \
    --preview="$self --diff '$wt' {1}" \
    --preview-window='right,65%,border-left' \
    --bind="ctrl-s:change-preview($self --diff '$wt' {1} sbs)+change-preview-window(down,75%,border-top)" \
    --bind='ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up,page-down:preview-down,page-up:preview-up' \
    --bind="ctrl-o:execute($self --diff '$wt' {1} | less -R)" \
    --bind="ctrl-l:execute(lazygit -p '$wt')+reload($self --files '$wt')"
}

case ${1:-} in
  --list) list "${2:-}"; exit;;
  --files) files "$2"; exit;;
  --tree) tree "$2"; exit;;
  --act) act "$2" "$3" "$4"; exit;;
  --act-hunk) act_hunk "$2" "$3" "$4" "$5"; exit;;
  --hunks) hunks "$2" "$3"; exit;;
  --hunk) hunk_diff "$2" "$3" "$4"; exit;;
  --changes) changes "$2" "$3"; exit;;
  --log) git -C "$2" log --oneline --color "$(base_of "$2")..HEAD"; exit;;
  --diff) diff_one "$2" "$3" "${4:-}"; exit;;
  --browse) browse "$2"; exit;;
esac

repo=${1:-}
list "$repo" | fzf --ansi --delimiter='\t' --with-nth=2 --no-sort --layout=reverse --cycle --header-lines=1 \
  --prompt='worktree> ' \
  --header='enter changed files · ctrl-l lazygit · ctrl-w tmux window · ctrl-y copy path · esc close' \
  --preview="$self --files {1} | cut -f2; echo; $self --log {1}" \
  --preview-window='down,45%,border-top' \
  --bind='page-down:preview-down,page-up:preview-up' \
  --bind="enter:execute($self --browse {1})+reload($self --list '$repo')" \
  --bind="ctrl-l:execute(lazygit -p {1})+reload($self --list '$repo')" \
  --bind="ctrl-w:execute-silent(tmux new-window -c {1} -n \"\$(basename {1})\")+abort" \
  --bind='ctrl-y:execute-silent(printf %s {1} | pbcopy)'
